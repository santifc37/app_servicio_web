# Configuración del broker MQTT de ejemplo.
# Cambia MQTT_TOPIC por el tópico real asignado por el docente.
# No uses aquí credenciales reales antes de copiar este archivo a .env.

# Variables del broker MQTT
MQTT_BROKER=emqx.coriotlab.co
MQTT_PORT=1883
MQTT_TOPIC=iot/sensors/ENV-003/data
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_KEEPALIVE=60

# Variables de conexión a PostgreSQL
DB_HOST=190.248.28.132
DB_PORT=3002
DB_NAME=appdb
DB_USER=
DB_PASSWORD=
